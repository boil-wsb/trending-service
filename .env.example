# Trending Service 环境变量配置
# 复制此文件为 .env 并填入实际值（.env 已被 ）

# llm-stats.com API Key（AI 模型排名功能，免费申请: https://llm-stats.com/developer，社区版 250 次/天）
LLM_STATS_API_KEY=your_api_key_here

# 知乎登录认证
# ZHIHU_USERNAME=your_phone_number
# ZHIHU_PASSWORD=your_password

# 代理设置（可选）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
